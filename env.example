# --- Backend (Render) ---------------------------------------------------

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL of THIS backend server (the Render service URL,
# e.g. https://dragon-council-api.onrender.com). Used to build the Discord
# OAuth redirect_uri. Must exactly match a redirect URI registered in your
# Discord Developer Portal application.
APP_URL="https://your-app.onrender.com"

# FRONTEND_URL: The public URL of the deployed frontend (the Vercel URL,
# e.g. https://dragon-council.vercel.app). Used for CORS — only requests
# from this origin will be allowed to call the API with credentials.
# Comma-separate multiple origins if you have more than one (e.g. a
# Vercel preview URL alongside your production domain).
FRONTEND_URL="https://your-app.vercel.app"

# DATABASE_URL: Neon Postgres connection string. Get this from your Neon
# project dashboard — use the "pooled connection" string for Render.
# Example: postgres://user:password@ep-xxxx.us-east-2.aws.neon.tech/dbname?sslmode=require
DATABASE_URL="postgres://user:password@your-neon-host/dbname?sslmode=require"

# Discord OAuth Client Credentials (from the Discord Developer Portal)
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# NODE_ENV: Render sets this automatically in most cases, but set it
# explicitly to "production" if it isn't already.
NODE_ENV="production"

# --- Frontend (Vercel) ---------------------------------------------------
# Set this one in the Vercel project's environment variables, not here —
# Vite only reads VITE_-prefixed vars from your local .env for local dev.
# It must point at the Render backend from the section above.
VITE_API_URL="https://your-app.onrender.com"
